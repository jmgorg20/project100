# Copy to deploy/.env (never commit it). Every value here is a placeholder.
# Make long random values with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

SERVICE_ENV=production
SERVICE_PUBLIC_URL=https://api.example.com
# The service connects as autoedit_app (an ordinary user: row-level security applies), not as the
# Postgres superuser below. Same password as APP_DB_PASSWORD.
SERVICE_DATABASE_URL=postgresql://autoedit_app:CHANGE_ME_app_db_password@db:5432/autoedit
SERVICE_SECRET_KEY=CHANGE_ME_long_random_value
SERVICE_ADMIN_TOKEN=CHANGE_ME_another_long_random_value
SERVICE_SIGNING_KEY_FILE=/run/secrets/signing-key.pem
SERVICE_REQUIRE_HTTPS=true
SERVICE_TRUSTED_PROXIES=172.16.0.0/12
SERVICE_CORS_ORIGINS=https://app.example.com
SERVICE_RETENTION_DAYS=3
SERVICE_DELETE_AFTER_DOWNLOAD_HOURS=24
SERVICE_MAX_UPLOAD_MB=1024
SERVICE_MAX_DURATION_SECONDS=900
# SERVICE_SCAN_COMMAND=clamdscan --no-summary {path}

# Running-cost prices for the admin pages (docs/admin.md): set them to YOUR prices
# SERVICE_COST_CPU_SECOND=0.00002
# SERVICE_COST_GPU_SECOND=0.0004
# SERVICE_COST_GB_MONTH=0.021
# SERVICE_COST_GB_EGRESS=0.09
# SERVICE_FX_RATES=PHP=0.0172

# Billing for the web app (docs/billing.md). Off until you are ready.
SERVICE_BILLING=off
# SERVICE_BILLING_PROVIDER=paddle
# SERVICE_PADDLE_ENVIRONMENT=sandbox
# SERVICE_PADDLE_API_KEY=CHANGE_ME
# SERVICE_BILLING_WEBHOOK_SECRET=CHANGE_ME
# SERVICE_TRIAL_DAYS=7
# SERVICE_TRIAL_MINUTES=30
# SERVICE_GRACE_DAYS=3

# Postgres container (only if you run the database in docker-compose instead of Supabase)
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=autoedit
APP_DB_PASSWORD=CHANGE_ME_app_db_password

# Accounts (the web app). Invite-only at first; pause or open with: service-admin signups closed|open
SERVICE_APP_URL=https://app.example.com/app/
SERVICE_SIGNUP_MODE=invite
SERVICE_EMAIL_BACKEND=smtp
SERVICE_EMAIL_FROM=AutoEdit <no-reply@example.com>
SERVICE_SMTP_HOST=smtp.example.com
SERVICE_SMTP_PORT=587
SERVICE_SMTP_USER=CHANGE_ME
SERVICE_SMTP_PASSWORD=CHANGE_ME
# Bot check on sign-up / reset (Cloudflare Turnstile or hCaptcha); leave empty to turn off
# SERVICE_CAPTCHA_PROVIDER=turnstile
# SERVICE_CAPTCHA_SITE_KEY=CHANGE_ME
# SERVICE_CAPTCHA_SECRET=CHANGE_ME
# Sign in with Google (console.cloud.google.com > Credentials > OAuth client, type Web; redirect URI
# https://API_DOMAIN/v1/auth/oauth/google/callback); leave empty to turn off
# SERVICE_OAUTH_GOOGLE_CLIENT_ID=CHANGE_ME
# SERVICE_OAUTH_GOOGLE_CLIENT_SECRET=CHANGE_ME

# The CPU worker container (a token from: python editor.py service-admin worker-create cpu-1)
AUTOEDIT_SERVER=http://api:8787
AUTOEDIT_WORKER_TOKEN=wk_CHANGE_ME
AUTOEDIT_SERVICE_PUBLIC_KEY=/run/secrets/signing-key.pem.pub
GROQ_API_KEY=CHANGE_ME
