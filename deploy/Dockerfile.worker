# A CPU worker: the engine + the worker agent. It connects OUT to the API; it needs no open port.
#   docker build -f deploy/Dockerfile.worker -t autoedit-worker .
# GPU workers (WanGP / ComfyUI) normally run on the owner's Windows PC with the same agent:
# see docs/service.md ("A worker on your PC"). No model weights are in this image.
ARG BASE=ubuntu:24.04
# Offline / air-gapped builds can bring Playwright's browsers (the version playwright-core 1.56.1
# wants): docker build --build-context pwbrowsers=/path/to/ms-playwright ... Otherwise they are
# downloaded during the build.
FROM scratch AS pwbrowsers
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 PATH=/opt/venv/bin:$PATH PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    NODE_ENV=production

# FFmpeg renders; Node + Chromium draw the motion graphics (desktop/graphics).
# Behind a TLS-inspecting proxy, pass its CA as a build secret (see Dockerfile.api).
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -f /run/secrets/extra_ca ]; then \
      mkdir -p /usr/local/share/ca-certificates /etc/ssl/certs \
      && cp /run/secrets/extra_ca /usr/local/share/ca-certificates/extra-ca.crt \
      && cat /run/secrets/extra_ca >> /etc/ssl/certs/ca-certificates.crt \
      && sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources; fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv ffmpeg nodejs npm \
      fonts-noto-color-emoji fontconfig \
 && if [ -f /usr/local/share/ca-certificates/extra-ca.crt ]; then update-ca-certificates; fi \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/venv \
 && groupadd --system app && useradd --system --gid app --home /work --shell /usr/sbin/nologin app

WORKDIR /app
COPY requirements-worker.txt ./
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -f /run/secrets/extra_ca ]; then export PIP_CERT=/etc/ssl/certs/ca-certificates.crt; fi \
 && pip install -r requirements-worker.txt
COPY desktop/graphics ./desktop/graphics
COPY --from=pwbrowsers . /opt/pw-browsers
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -f /run/secrets/extra_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/extra_ca; fi \
 && cd desktop/graphics \
 && npm install --no-save --no-package-lock --no-audit --no-fund playwright-core@1.56.1 \
 && if [ -z "$(ls -A /opt/pw-browsers 2>/dev/null)" ]; then \
      node node_modules/playwright-core/cli.js install --with-deps chromium; \
    else node node_modules/playwright-core/cli.js install-deps chromium; fi \
 && npm cache clean --force && rm -rf /var/lib/apt/lists/* /root/.npm
COPY editor.py config.yaml ./
COPY autoedit ./autoedit
COPY service ./service
COPY assets ./assets
COPY deploy/worker.yaml ./deploy/worker.yaml
# a build-time proxy CA is not kept in the image
RUN if [ -f /usr/local/share/ca-certificates/extra-ca.crt ]; then \
      rm -f /usr/local/share/ca-certificates/extra-ca.crt && update-ca-certificates --fresh >/dev/null; fi \
 && mkdir -p /work && chown app:app /work

USER app
ENV HOME=/work AUTOEDIT_WORKER_QUEUES=cpu AUTOEDIT_GRAPHICS_CACHE=/work/graphics AUTOEDIT_SFX_CACHE=/work/sfx \
    AUTOEDIT_MASK_CACHE=/work/masks AUTOEDIT_GENERATION_HOME=/work/generation
# AUTOEDIT_SERVER, AUTOEDIT_WORKER_TOKEN and the public key file come from the environment
CMD ["python", "editor.py", "worker", "--work-dir", "/work/jobs", "--config", "/app/deploy/worker.yaml"]
