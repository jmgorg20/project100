# Copy this file to a new file named ".env" (same folder) and paste your key.
# Get a free key at https://console.groq.com/keys
# Never share your .env file or upload it anywhere.
GROQ_API_KEY=your_groq_api_key_here

# Optional: free stock B-roll (both are free; the key stays on your PC).
# Pexels: https://www.pexels.com/api/   Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here
