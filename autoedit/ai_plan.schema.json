{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI edit plan",
  "description": "What the AI decided for one video. Times are seconds in the RAW video. The editor turns this into a Project with its normal, tested steps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "style",
    "grade",
    "pacing",
    "zoom",
    "captions",
    "cuts",
    "zooms",
    "grades",
    "effects",
    "tracked_effects",
    "photos",
    "notes",
    "ai_clips",
    "voiceovers"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 600,
      "description": "One to three short sentences for the creator, in the language of their instruction."
    },
    "style": {
      "enum": [
        "classic",
        "yellow_pop",
        "boxed",
        "bold_caps",
        "minimal",
        "neon_green",
        "one_word",
        "pink_highlight",
        "thick_outline",
        "top_banner",
        "center_keyword",
        "typewriter",
        "pop_word"
      ],
      "description": "Caption style."
    },
    "grade": {
      "enum": [
        "natural_clean",
        "none",
        "warm",
        "black_and_white",
        "orange_teal",
        "high_contrast"
      ],
      "description": "Colour grade for the whole video."
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "silence_threshold",
        "remove_fillers"
      ],
      "properties": {
        "silence_threshold": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 2.0,
          "description": "Cut pauses longer than this many seconds. 0.25 = fast, 0.6 = relaxed."
        },
        "remove_fillers": {
          "type": "boolean",
          "description": "Cut ah/uh/um/uhm/eh."
        }
      }
    },
    "zoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "amount"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Automatic punch-in zoom on jump cuts."
        },
        "amount": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 1.6,
          "description": "1.15 = 115%."
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "size_scale",
        "position",
        "highlight_words"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size_scale": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.8,
          "description": "1 = the style's normal size; 1.3 = 30% bigger."
        },
        "position": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "lower",
                "center",
                "top"
              ]
            }
          ],
          "description": "null = the style's own position."
        },
        "highlight_words": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "description": "Extra words to show in the keyword colour."
        }
      }
    },
    "cuts": {
      "type": "array",
      "maxItems": 200,
      "description": "Extra parts to REMOVE (retakes, mistakes, topics the creator wants gone). Pauses and fillers are cut automatically; do not list them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "reason"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds in the RAW video (use the transcript times)."
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds in the RAW video (use the transcript times)."
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "zooms": {
      "type": "array",
      "maxItems": 100,
      "description": "Extra zoom-ins for emphasis.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "amount"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds in the RAW video (use the transcript times)."
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds in the RAW video (use the transcript times)."
          },
          "amount": {
            "type": "number",
            "minimum": 1.0,
            "maximum": 2.0
          }
        }
      }
    },
    "grades": {
      "type": "array",
      "maxItems": 50,
      "description": "A different colour grade for part of the video.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "grade"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds in the RAW video (use the transcript times)."
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds in the RAW video (use the transcript times)."
          },
          "grade": {
            "enum": [
              "natural_clean",
              "none",
              "warm",
              "black_and_white",
              "orange_teal",
              "high_contrast"
            ]
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 30,
      "description": "Short visual accents: flash (to white), whip (sideways blur), shake, glitch, dip (to black). Only if the creator asks for effects/transitions, or for a clear punchline or topic change. Empty otherwise.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "effect",
          "at",
          "duration",
          "intensity",
          "on_cut",
          "reason"
        ],
        "properties": {
          "effect": {
            "enum": [
              "shake",
              "flash",
              "dip",
              "glitch",
              "whip"
            ]
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds in the RAW video (use the transcript times)."
          },
          "duration": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 2.0,
            "description": "Seconds; 0.2 to 0.5 is usual."
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "0.6 is normal; 1 is strong."
          },
          "on_cut": {
            "type": "boolean",
            "description": "true = a transition: placed on the jump cut nearest to `at`."
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "tracked_effects": {
      "type": "array",
      "maxItems": 12,
      "description": "Effects that follow the speaker's hand, face or body (a glow at the fingertips, sparks on the palm, an aura around them). Only if TRACKED EFFECTS says tracking is available AND the creator asks for such an effect. Empty otherwise. `at` is when the speaker says the matching word.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "effect",
          "point",
          "hand",
          "at",
          "duration",
          "intensity",
          "color",
          "size",
          "reason"
        ],
        "properties": {
          "effect": {
            "enum": [
              "glow",
              "spark",
              "aura",
              "energy"
            ],
            "description": "glow = a soft light; spark = particles thrown off; aura = a glowing outline around the face or body; energy = a pulsing core with rings."
          },
          "point": {
            "enum": [
              "palm",
              "wrist",
              "index_tip",
              "thumb_tip",
              "fingertips",
              "face",
              "body"
            ],
            "description": "What to follow. aura goes with face or body; the others with a hand."
          },
          "hand": {
            "enum": [
              "left",
              "right",
              "any"
            ],
            "description": "Which hand; any = whichever is found. Ignored for face and body."
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds in the RAW video (use the transcript times)."
          },
          "duration": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 8.0,
            "description": "Seconds; 1.5 to 4 is usual."
          },
          "intensity": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1.0,
            "description": "0.8 is normal."
          },
          "color": {
            "enum": [
              "default",
              "gold",
              "white",
              "blue",
              "cyan",
              "purple",
              "pink",
              "red",
              "orange",
              "green"
            ]
          },
          "size": {
            "type": "number",
            "minimum": 0.3,
            "maximum": 3.0,
            "description": "1 = normal."
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "photos": {
      "type": "array",
      "maxItems": 50,
      "description": "Pop-in photos. Only use the given file names.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "at",
          "duration",
          "position",
          "reason"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds in the RAW video (use the transcript times)."
          },
          "duration": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 10.0,
            "description": "Seconds on screen."
          },
          "position": {
            "enum": [
              "top",
              "center"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 300
      },
      "description": "Things in the instruction the editor cannot do (say so plainly). Empty if none."
    },
    "ai_clips": {
      "type": "array",
      "maxItems": 20,
      "description": "B-roll: pictures or short video clips shown over the speaker. Each one is taken from the creator's own B-roll library, else free stock (if the creator gave a key), else made with AI generation, as B-ROLL SOURCES says. Only when the creator asked for B-roll/visuals or it clearly helps, and only if some source is available. Empty otherwise.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "prompt",
          "search",
          "style",
          "source",
          "at",
          "duration",
          "position",
          "reason"
        ],
        "properties": {
          "kind": {
            "enum": [
              "image",
              "video"
            ]
          },
          "prompt": {
            "type": "string",
            "maxLength": 500,
            "description": "What to show, in English, concrete and visual (used to generate it with AI). No real people's names or faces, no brands."
          },
          "search": {
            "type": "string",
            "maxLength": 80,
            "description": "2 to 4 English keywords to find it in the creator's library or stock sites, e.g. \"coffee cup\", \"jeepney street\"."
          },
          "style": {
            "enum": [
              "realistic",
              "cartoon",
              "drawing",
              "low_poly",
              "stylized_3d",
              "anime"
            ],
            "description": "Look: realistic (real footage/photo), cartoon, drawing (hand-drawn sketch), low_poly (boxy 3D), stylized_3d (toy/robot-like 3D), anime. realistic unless the creator asks for another look."
          },
          "source": {
            "enum": [
              "auto",
              "library",
              "stock",
              "ai"
            ],
            "description": "auto = library, then stock, then AI. Only another value if the creator asks (e.g. \"AI-generated lang\")."
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds in the RAW video (use the transcript times)."
          },
          "duration": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 10.0,
            "description": "Seconds on screen."
          },
          "position": {
            "enum": [
              "full",
              "top",
              "center"
            ],
            "description": "full = covers the screen as a cutaway; top/center = a smaller pop-in."
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "voiceovers": {
      "type": "array",
      "maxItems": 20,
      "description": "AI voice-over lines, only if AI GENERATION says voice is available and the creator asked for it. Empty otherwise.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "at",
          "reason"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 500,
            "description": "Exactly what the voice says, in the creator's language."
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds in the RAW video (use the transcript times)."
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
