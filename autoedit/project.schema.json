{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoedit.local/project.schema.json",
  "title": "Auto video editor Project",
  "description": "One edit: media files plus a timeline of tracks and clips. All clip times are seconds on the timeline; 'in'/'out' are seconds in the source file. The AI writes it, the app edits it, the FFmpeg engine renders it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "settings",
    "media",
    "tracks"
  ],
  "properties": {
    "format": {
      "const": "autoedit-project"
    },
    "version": {
      "enum": [
        1,
        2
      ],
      "description": "1 or 2. Version 2 adds speed, fades on video clips and crop (reframe); version 1 files load unchanged."
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "transcript": {
      "$ref": "#/$defs/transcript"
    },
    "tracking": {
      "type": "object",
      "description": "Tracked points per media id.",
      "additionalProperties": {
        "$ref": "#/$defs/trackData"
      }
    },
    "meta": {
      "type": "object",
      "description": "Free-form notes (who made it, pipeline settings)."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "nullableColor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      ]
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "maximum": 4
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "const": 1080,
          "description": "Version 1 is vertical 1080x1920 only; export can scale down."
        },
        "height": {
          "const": 1920
        },
        "fps": {
          "enum": [
            24,
            25,
            30,
            50,
            60
          ],
          "description": "Frames per second. Only rates where 48 kHz audio splits into whole samples per frame."
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "normalize": {
              "type": "boolean",
              "description": "Even out speech loudness (dialog: main video, original, voice-over)."
            },
            "loudness": {
              "type": "number",
              "minimum": -70,
              "maximum": -5
            },
            "true_peak": {
              "type": "number",
              "minimum": -9,
              "maximum": 0
            },
            "ducking": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Lower the music while someone speaks: 0 = off, 1 = strongest."
            },
            "denoise": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Reduce steady background noise (fan, hiss) in the speech: 0 = off, 1 = strongest."
            }
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "regular": {
              "type": "string",
              "minLength": 1
            },
            "bold": {
              "type": "string",
              "minLength": 1
            },
            "heavy": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "duration"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "video",
            "image",
            "audio"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute, or relative to the project file."
        },
        "name": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds (0 for images)."
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "has_audio": {
          "type": "boolean"
        }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media",
        "language",
        "words"
      ],
      "properties": {
        "media": {
          "$ref": "#/$defs/id"
        },
        "language": {
          "type": "string"
        },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "start",
              "end"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "clips"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "video",
            "overlay",
            "effect",
            "caption",
            "audio",
            "graphics"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "role": {
          "enum": [
            "original",
            "voiceover",
            "music",
            "sfx"
          ]
        },
        "muted": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "clips": {
          "type": "array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "graphics"
              }
            }
          },
          "then": {
            "properties": {
              "clips": {
                "items": {
                  "$ref": "#/$defs/graphicClip"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "video"
              }
            }
          },
          "then": {
            "properties": {
              "clips": {
                "items": {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "image"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "$ref": "#/$defs/imageClip"
                  },
                  "else": {
                    "$ref": "#/$defs/videoClip"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "overlay"
              }
            }
          },
          "then": {
            "properties": {
              "clips": {
                "items": {
                  "$ref": "#/$defs/overlayClip"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "effect"
              }
            }
          },
          "then": {
            "properties": {
              "clips": {
                "items": {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "grade"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "$ref": "#/$defs/gradeClip"
                  },
                  "else": {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "fx"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "$ref": "#/$defs/fxClip"
                    },
                    "else": {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "trackfx"
                          }
                        },
                        "required": [
                          "type"
                        ]
                      },
                      "then": {
                        "$ref": "#/$defs/trackFxClip"
                      },
                      "else": {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "wipe"
                            }
                          },
                          "required": [
                            "type"
                          ]
                        },
                        "then": {
                          "$ref": "#/$defs/wipeClip"
                        },
                        "else": {
                          "$ref": "#/$defs/zoomClip"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "caption"
              }
            }
          },
          "then": {
            "properties": {
              "clips": {
                "items": {
                  "$ref": "#/$defs/captionClip"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "audio"
              }
            }
          },
          "then": {
            "required": [
              "role"
            ],
            "properties": {
              "clips": {
                "items": {
                  "$ref": "#/$defs/audioClip"
                }
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "role"
              ]
            }
          }
        }
      ]
    },
    "videoClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "duration",
        "media",
        "in",
        "out"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "const": "video"
        },
        "media": {
          "$ref": "#/$defs/id"
        },
        "in": {
          "type": "number",
          "minimum": 0
        },
        "out": {
          "type": "number",
          "minimum": 0
        },
        "volume": {
          "$ref": "#/$defs/volume"
        },
        "fit": {
          "enum": [
            "fill",
            "blur"
          ],
          "description": "fill = crop to fill the frame; blur = whole picture over a blurred copy."
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "screen"
          ],
          "description": "Combine with another video: a screen recording (split: it on top), the video you react to (pip: it fills the screen, you small), or a second video. `offset`: the other video's time = this clip's time + offset.",
          "properties": {
            "type": {
              "enum": [
                "split",
                "pip"
              ]
            },
            "screen": {
              "$ref": "#/$defs/id"
            },
            "ratio": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 0.7,
              "description": "split: the share of the height for the other video (default 0.6)."
            },
            "corner": {
              "enum": [
                "top_left",
                "top_right",
                "bottom_left",
                "bottom_right"
              ],
              "description": "pip: where you sit (default top_left)."
            },
            "size": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 0.6,
              "description": "pip: your width as a share of the frame (default 0.33)."
            },
            "border": {
              "$ref": "#/$defs/color"
            },
            "animated": {
              "type": "boolean",
              "description": "pip: the border colour cycles."
            },
            "offset": {
              "type": "number",
              "minimum": -3600,
              "maximum": 3600
            }
          }
        },
        "speed": {
          "$ref": "#/$defs/speed"
        },
        "fade_in": {
          "$ref": "#/$defs/fade"
        },
        "fade_out": {
          "$ref": "#/$defs/fade"
        },
        "crop": {
          "$ref": "#/$defs/crop"
        },
        "locked": {
          "type": "boolean",
          "description": "A locked clip cannot be moved, changed or deleted until unlocked (the AI does not touch it either). The storyboard's \"Lock scene\" sets it."
        }
      }
    },
    "imageClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "duration",
        "media"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "const": "image"
        },
        "media": {
          "$ref": "#/$defs/id"
        },
        "fit": {
          "enum": [
            "fill",
            "blur"
          ]
        },
        "crop": {
          "$ref": "#/$defs/crop"
        },
        "locked": {
          "type": "boolean",
          "description": "A locked clip cannot be moved, changed or deleted until unlocked (the AI does not touch it either). The storyboard's \"Lock scene\" sets it."
        }
      }
    },
    "overlayClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "duration",
        "media",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "enum": [
            "image",
            "video"
          ]
        },
        "media": {
          "$ref": "#/$defs/id"
        },
        "in": {
          "type": "number",
          "minimum": 0
        },
        "out": {
          "type": "number",
          "minimum": 0
        },
        "x": {
          "type": "number",
          "description": "Centre x in pixels on the 1080x1920 frame."
        },
        "y": {
          "type": "number",
          "description": "Centre y in pixels."
        },
        "width": {
          "type": "number",
          "description": "The picture is scaled to fit inside width x height.",
          "minimum": 1
        },
        "height": {
          "type": "number",
          "minimum": 1
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "animation": {
          "enum": [
            "none",
            "pop"
          ]
        },
        "speed": {
          "$ref": "#/$defs/speed"
        },
        "broll": {
          "$ref": "#/$defs/broll"
        },
        "mask": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "description": "Cut out part of the picture: `person` (found by a person segmentation model) or `chroma` (a green / blue screen keyed out).",
          "properties": {
            "type": {
              "enum": [
                "person",
                "chroma"
              ]
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "similarity": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 0.6
            },
            "blend": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            }
          }
        },
        "locked": {
          "type": "boolean",
          "description": "A locked clip cannot be moved, changed or deleted until unlocked (the AI does not touch it either). The storyboard's \"Lock scene\" sets it."
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "video"
          }
        }
      },
      "then": {
        "required": [
          "in",
          "out"
        ]
      }
    },
    "zoomClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "duration",
        "amount"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "const": "zoom"
        },
        "amount": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "anchor_y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ease": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "Seconds to zoom in smoothly from 100% (0 = jump straight in, a punch-in)."
        },
        "locked": {
          "type": "boolean",
          "description": "A locked clip cannot be moved, changed or deleted until unlocked (the AI does not touch it either). The storyboard's \"Lock scene\" sets it."
        }
      }
    },
    "gradeClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "duration",
        "grade"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "const": "grade"
        },
        "grade": {
          "enum": [
            "natural_clean",
            "none",
            "warm",
            "black_and_white",
            "orange_teal",
            "high_contrast"
          ]
        },
        "intensity": {
          "$ref": "#/$defs/intensity"
        },
        "locked": {
          "type": "boolean",
          "description": "A locked clip cannot be moved, changed or deleted until unlocked (the AI does not touch it either). The storyboard's \"Lock scene\" sets it."
        }
      }
    },
    "captionClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "duration",
        "style",
        "words"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "const": "caption"
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "classic",
                "yellow_pop",
                "boxed",
                "bold_caps",
                "minimal",
                "neon_green",
                "one_word",
                "pink_highlight",
                "thick_outline",
                "top_banner",
                "center_keyword",
                "typewriter",
                "pop_word",
                "editorial_card"
              ]
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 14
            }
          ]
        },
        "highlight_keywords": {
          "type": "boolean"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "font": {
              "enum": [
                "regular",
                "bold",
                "heavy"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 16,
              "maximum": 300
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "active_color": {
              "$ref": "#/$defs/nullableColor"
            },
            "active_box": {
              "$ref": "#/$defs/nullableColor"
            },
            "keyword_color": {
              "$ref": "#/$defs/nullableColor"
            },
            "outline": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "outline_color": {
              "$ref": "#/$defs/color"
            },
            "shadow": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "uppercase": {
              "type": "boolean"
            },
            "lowercase": {
              "type": "boolean"
            },
            "zone": {
              "enum": [
                "lower",
                "center",
                "top",
                "divider"
              ]
            },
            "align": {
              "enum": [
                "center",
                "left"
              ]
            },
            "words_per_line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "max_lines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          }
        },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "start",
              "end"
            ],
            "description": "Word times are seconds from the start of the caption clip.",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "highlight": {
                "type": "boolean"
              }
            }
          }
        },
        "locked": {
          "type": "boolean",
          "description": "A locked clip cannot be moved, changed or deleted until unlocked (the AI does not touch it either). The storyboard's \"Lock scene\" sets it."
        }
      }
    },
    "audioClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "duration",
        "media",
        "in",
        "out"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "const": "audio"
        },
        "media": {
          "$ref": "#/$defs/id"
        },
        "in": {
          "type": "number",
          "minimum": 0
        },
        "out": {
          "type": "number",
          "minimum": 0
        },
        "volume": {
          "$ref": "#/$defs/volume"
        },
        "fade_in": {
          "type": "number",
          "minimum": 0
        },
        "fade_out": {
          "type": "number",
          "minimum": 0
        },
        "speed": {
          "$ref": "#/$defs/speed"
        },
        "locked": {
          "type": "boolean",
          "description": "A locked clip cannot be moved, changed or deleted until unlocked (the AI does not touch it either). The storyboard's \"Lock scene\" sets it."
        }
      }
    },
    "speed": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 4,
      "description": "Playback speed: 2 = twice as fast. The clip plays (out - in) / speed seconds."
    },
    "fade": {
      "type": "number",
      "minimum": 0,
      "description": "Sound fade length in seconds."
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reframe for 'fill': zoom in (1 = just fill the frame) and choose which part stays in view (x, y: 0 = left/top, 0.5 = centre, 1 = right/bottom).",
      "properties": {
        "zoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "How strong: 0 = not at all, 1 = full."
    },
    "fxClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "duration",
        "effect"
      ],
      "description": "A picture effect for a moment (also used as a transition on a cut): shake, flash (to white), dip (to black), glitch (colour split and noise), whip (sideways motion blur).",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "const": "fx"
        },
        "effect": {
          "enum": [
            "shake",
            "flash",
            "dip",
            "glitch",
            "whip"
          ]
        },
        "intensity": {
          "$ref": "#/$defs/intensity"
        },
        "locked": {
          "type": "boolean",
          "description": "A locked clip cannot be moved, changed or deleted until unlocked (the AI does not touch it either). The storyboard's \"Lock scene\" sets it."
        }
      }
    },
    "broll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "description": "Where a B-roll clip came from, so it can be found again, regenerated or credited.",
      "properties": {
        "source": {
          "enum": [
            "library",
            "pexels",
            "pixabay",
            "ai",
            "file"
          ],
          "description": "library = your B-roll folder; pexels/pixabay = free stock; ai = generated (WanGP); file = chosen by hand."
        },
        "kind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 500
        },
        "search": {
          "type": "string",
          "maxLength": 120
        },
        "style": {
          "enum": [
            "realistic",
            "cartoon",
            "drawing",
            "low_poly",
            "stylized_3d",
            "anime"
          ]
        },
        "position": {
          "enum": [
            "full",
            "top",
            "center"
          ]
        },
        "ai_generated": {
          "type": "boolean",
          "description": "Made with AI: label it where the platform asks (TikTok, Facebook, YouTube)."
        },
        "tier": {
          "type": "string",
          "maxLength": 40
        },
        "stock_id": {
          "type": "string",
          "maxLength": 80
        },
        "author": {
          "type": "string",
          "maxLength": 200
        },
        "page": {
          "type": "string",
          "maxLength": 500
        },
        "license": {
          "type": "string",
          "maxLength": 120
        },
        "license_url": {
          "type": "string",
          "maxLength": 500
        },
        "credit": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "trackPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "c"
      ],
      "description": "One tracked point: samples at start + i / fps. x, y: 0-1 across the source frame (y down); c: confidence (0 = not found); s: size as a fraction of the frame width.",
      "properties": {
        "x": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "y": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "c": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "s": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "trackData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fps",
        "points"
      ],
      "description": "Where the speaker's hands, face and body are in one video (see docs/tracking.md).",
      "properties": {
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "swap_hands": {
          "type": "boolean"
        },
        "points": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/trackPoint"
          }
        }
      }
    },
    "trackFxClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "duration",
        "effect"
      ],
      "description": "An effect that follows a tracked point (a hand, the face or the body) of the main video: a glow, sparks, an aura, pulsing energy rings, or your own clip (black background, screen blend; or with alpha).",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "const": "trackfx"
        },
        "effect": {
          "enum": [
            "glow",
            "spark",
            "aura",
            "energy",
            "clip"
          ]
        },
        "point": {
          "enum": [
            "palm",
            "wrist",
            "thumb_tip",
            "index_tip",
            "middle_tip",
            "ring_tip",
            "pinky_tip",
            "fingertips",
            "face",
            "body"
          ],
          "description": "Which point to follow (default palm). 'fingertips' = all five fingertips."
        },
        "hand": {
          "enum": [
            "left",
            "right",
            "any"
          ],
          "description": "Which hand (default any: the one found most). Ignored for face and body."
        },
        "intensity": {
          "$ref": "#/$defs/intensity"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "size": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 4,
          "description": "1 = normal size."
        },
        "smooth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = follow the raw points, 1 = very steady."
        },
        "fade_in": {
          "$ref": "#/$defs/fade"
        },
        "fade_out": {
          "$ref": "#/$defs/fade"
        },
        "media": {
          "$ref": "#/$defs/id"
        },
        "blend": {
          "enum": [
            "screen",
            "alpha"
          ],
          "description": "effect 'clip': black background added with screen blend (default), or a clip with its own alpha."
        },
        "locked": {
          "type": "boolean",
          "description": "A locked clip cannot be moved, changed or deleted until unlocked (the AI does not touch it either). The storyboard's \"Lock scene\" sets it."
        }
      },
      "if": {
        "properties": {
          "effect": {
            "const": "clip"
          }
        },
        "required": [
          "effect"
        ]
      },
      "then": {
        "required": [
          "media"
        ]
      },
      "else": {
        "not": {
          "required": [
            "media"
          ]
        }
      }
    },
    "graphicParams": {
      "type": "object",
      "additionalProperties": false,
      "description": "What a graphics template shows: the words, numbers, colours and size. Which of these a template uses is listed in graphics_catalog.json.",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200
        },
        "text2": {
          "type": "string",
          "maxLength": 120
        },
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "number": {
          "type": "number"
        },
        "prefix": {
          "type": "string",
          "maxLength": 8
        },
        "suffix": {
          "type": "string",
          "maxLength": 12
        },
        "image": {
          "$ref": "#/$defs/id",
          "description": "Id of an image in `media`."
        },
        "emoji": {
          "type": "string",
          "maxLength": 16
        },
        "icon": {
          "type": "string",
          "maxLength": 24
        },
        "font": {
          "type": "string",
          "maxLength": 24
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "bg": {
          "$ref": "#/$defs/color"
        },
        "size": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 2.5,
          "description": "1 = normal size."
        },
        "intensity": {
          "$ref": "#/$defs/intensity"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "case": {
          "enum": [
            "",
            "upper",
            "lower",
            "title"
          ]
        },
        "angle": {
          "type": "number",
          "minimum": -360,
          "maximum": 360,
          "description": "Degrees; 0 = pointing right, 90 = down (arrows)."
        },
        "dir": {
          "enum": [
            "left",
            "right",
            "up",
            "down"
          ]
        },
        "images": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Ids of several images in `media` (your screenshots / photos: collage, mosaic, montage, storyboard)."
        },
        "cues": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 600
          },
          "description": "Seconds from the graphic's start when each word / item / step appears (the Director sets them from the spoken words)."
        }
      }
    },
    "graphicClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "duration",
        "template",
        "x",
        "y"
      ],
      "description": "A motion graphic (pop-up word, card, pill, counter, arrow, emoji...) drawn from a template. x and y are where its centre sits, as fractions of the frame (0.5, 0.5 = the middle).",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "const": "graphic"
        },
        "template": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,48}$"
        },
        "params": {
          "$ref": "#/$defs/graphicParams"
        },
        "x": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 1.5
        },
        "y": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 1.5
        },
        "attach": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "description": "A transition on the picture at the graphic's start (flash, whip or punch-in).",
          "properties": {
            "kind": {
              "enum": [
                "flash",
                "whip",
                "punch"
              ]
            },
            "intensity": {
              "$ref": "#/$defs/intensity"
            }
          }
        },
        "locked": {
          "type": "boolean",
          "description": "A locked graphic cannot be moved, changed or deleted until unlocked (and the AI will not regenerate it)."
        },
        "director": {
          "type": "object",
          "description": "Why the AI placed it: the words it belongs to, the mood, the style. Free-form notes."
        }
      }
    },
    "wipeClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "start",
        "duration",
        "grade"
      ],
      "description": "A before/after wipe: a divider sweeps across the picture; one side shows the colour grade, the other side stays as it was.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "const": "wipe"
        },
        "grade": {
          "enum": [
            "natural_clean",
            "none",
            "warm",
            "black_and_white",
            "orange_teal",
            "high_contrast"
          ]
        },
        "intensity": {
          "$ref": "#/$defs/intensity"
        },
        "direction": {
          "enum": [
            "right",
            "left",
            "down",
            "up"
          ],
          "description": "The way the divider travels (default right)."
        },
        "sweep": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3,
          "description": "Seconds the divider takes to get there."
        },
        "stop": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.95,
          "description": "Where the divider ends, as a fraction of the frame (0.5 = the middle; 0.95 = nearly all graded)."
        },
        "divider": {
          "type": "boolean",
          "description": "Draw a thin white line at the divider (default true)."
        },
        "locked": {
          "type": "boolean",
          "description": "A locked clip cannot be moved, changed or deleted until unlocked (the AI does not touch it either). The storyboard's \"Lock scene\" sets it."
        }
      }
    }
  }
}
